---
import '../styles/global.css';
import { tabs } from '../pages/tabs';

interface Props {
  title?: string;
  description?: string;
  activeTab: 'about' | 'projects' | 'skills' | 'contact';
}

const {
  title = 'Alex Knigge — Portfolio',
  description = 'Alex Knigge — CS researcher focused on high-performance and parallel computing.',
  activeTab,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="gutter" id="gutter" aria-hidden="true"></div>

    <div class="frame">
      <nav class="tabs" aria-label="Sections">
        {tabs.map((t) => (
          <a
            href={t.href}
            class={`tab${t.id === activeTab ? ' active' : ''}`}
            style={`--tab-color: ${t.color}`}
          >
            {t.label}<span class="ext">{t.ext}</span>
          </a>
        ))}
      </nav>

      <main class="content">
        <slot />

        <footer class="footer">
          <p>Built with Astro · Deployed on Cloudflare Pages</p>
        </footer>
      </main>
    </div>

    <script>
      // Populate the gutter with line numbers based on document height,
      // keeping the baseline grid (var(--line)) in sync. Runs on every
      // page load since each route now has its own document height.
      const gutter = document.getElementById('gutter');

      function renderGutter() {
        const line = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--line')
        );
        const total = Math.ceil(document.body.scrollHeight / line) + 4;
        const current = gutter.children.length;

        if (current < total) {
          const frag = document.createDocumentFragment();
          for (let i = current + 1; i <= total; i++) {
            const span = document.createElement('span');
            span.textContent = String(i).padStart(3, '0');
            frag.appendChild(span);
          }
          gutter.appendChild(frag);
        } else if (current > total) {
          for (let i = current; i > total; i--) {
            gutter.removeChild(gutter.lastChild);
          }
        }
      }

      renderGutter();
      window.addEventListener('resize', renderGutter);
      new ResizeObserver(renderGutter).observe(document.body);
    </script>

    <style is:global>
      /* ============================================
         Gutter — persistent line numbers
         ============================================ */
      .gutter {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--gutter-w);
        padding-top: calc(var(--line) * 2);
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0;
        background: var(--bg);
        border-right: 1px solid var(--border);
        overflow: hidden;
        user-select: none;
        z-index: 5;
      }

      .gutter span {
        display: block;
        height: var(--line);
        line-height: var(--line);
        padding-right: 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-faint);
        white-space: nowrap;
      }

      @media (max-width: 720px) {
        .gutter {
          display: none;
        }
      }

      /* ============================================
         Frame / layout
         ============================================ */
      .frame {
        margin-left: var(--gutter-w);
        min-height: 100vh;
      }

      @media (max-width: 720px) {
        .frame {
          margin-left: 0;
        }
      }

      .content {
        max-width: var(--content-w);
        margin: 0 auto;
        padding: calc(var(--line) * 2) 24px calc(var(--line) * 4);
      }

      /* ============================================
         Tabs
         ============================================ */
      .tabs {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        gap: 1px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        overflow-x: auto;
      }

      .tab {
        flex: 0 0 auto;
        padding: 12px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-dim);
        text-decoration: none;
        background: var(--bg-tab);
        border-right: 1px solid var(--border);
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
        white-space: nowrap;
      }

      .tab .ext {
        color: var(--tab-color);
      }

      .tab:hover {
        color: var(--text);
      }

      .tab.active {
        color: var(--text);
        border-bottom-color: var(--tab-color);
        background: var(--bg-raised);
      }

      /* ============================================
         Code blocks (shared: hero code, JSON, shell)
         ============================================ */
      .code {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: var(--line);
        color: var(--text);
        white-space: pre;
        overflow-x: auto;
      }

      .c-comment { color: var(--text-dim); }
      .c-key     { color: var(--accent-purple); }
      .c-str     { color: var(--accent-cyan); }
      .c-var     { color: var(--text); }
      .c-fn      { color: var(--accent-amber); }
      .c-punct   { color: var(--text-dim); }
      .c-prompt  { color: var(--accent-pink); }
      .c-link    { color: var(--accent-cyan); text-decoration: underline; text-decoration-color: var(--border); }
      .c-link:hover { text-decoration-color: var(--accent-cyan); }

      /* ============================================
         File sections (shared shell used on every page)
         ============================================ */
      .file {
        margin-top: calc(var(--line) * 2);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        background: var(--bg-raised);
      }

      .file:first-child {
        margin-top: 0;
      }

      .file-bar {
        padding: 10px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-dim);
        background: var(--bg-tab);
        border-bottom: 1px solid var(--border);
      }

      .file-bar .ext {
        color: var(--tab-color);
      }

      .file-body {
        padding: var(--line) 28px calc(var(--line) * 1.5);
      }

      .file-body h2 {
        margin: 0 0 var(--line);
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        line-height: var(--line);
        color: var(--text);
      }

      .file-body p {
        margin: 0 0 var(--line);
        font-size: 16px;
        line-height: var(--line);
        color: var(--text-dim);
        max-width: 64ch;
      }

      .file-body p:last-child {
        margin-bottom: 0;
      }

      .file-body .code {
        margin-top: calc(var(--line) * -0.25);
      }

      .sh .c-link {
        color: var(--accent-cyan);
        text-decoration: none;
      }

      .sh .c-link:hover {
        text-decoration: underline;
      }

      /* ============================================
         Footer
         ============================================ */
      .footer {
        margin-top: calc(var(--line) * 2);
        padding-top: var(--line);
        border-top: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-faint);
        text-align: center;
      }

      .footer p {
        margin: 0;
        line-height: var(--line);
      }
    </style>
  </body>
</html>