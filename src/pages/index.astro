---
import BaseLayout from '../pages/base.astro';
---

<BaseLayout activeTab="about">
  <!-- Hero -->
  <header class="hero" id="top">
    <pre class="code"><code><span class="c-comment">// portfolio.ts</span>
<span class="c-key">import</span> {'{'} Researcher {'}'} <span class="c-key">from</span> <span class="c-str">'@me/profile'</span>;

<span class="c-key">const</span> <span class="c-var">alex</span> = <span class="c-key">new</span> <span class="c-fn">Researcher</span>({'{'}
  name: <span class="c-str">'Alex Knigge'</span>,
  role: <span class="c-str">'CS @ UNM — HPC &amp; parallel computing'</span>,
  focus: [<span class="c-str">'high-performance computing'</span>, <span class="c-str">'parallel computing'</span>, <span class="c-str">'systems benchmarking'</span>],
  status: <span class="c-str">'R&amp;D Intern @ Sandia National Laboratories'</span>,
{'}'});

<span class="c-key">export default</span> <span class="c-var">alex</span>;</code></pre>
  </header>

  <!-- About -->
  <section id="about" class="file">
    <div class="file-bar" style="--tab-color: var(--accent-green)">about<span class="ext">.md</span></div>
    <div class="file-body about-body">
      <img
        class="about-photo"
        src="/headshot.jpg"
        alt="Alex Knigge"
        width="160"
        height="160"
      />
      <div class="about-text">
        <h2>About</h2>
        <p>
          I'm a Computer Science graduate from the University of New Mexico
          (B.S., summa cum laude, minor in Mathematics) with a focus on
          high-performance and parallel computing. Most of my work lives at
          the intersection of systems and performance: profiling monitoring
          frameworks, parallelizing simulations with MPI and UPC++, and
          squeezing more out of GPU and CPU clusters.
        </p>
        <p>
          I'm currently an R&amp;D Intern at Sandia National Laboratories, where
          I study the overhead of HPC monitoring tools and build CI/CD
          pipelines for testing distributed systems. I also co-founded and
          coach UNM's HPC Student Cluster Competition team, competing at
          SC23, SC24, SC25, and ISC24, and previously served as a TA for HPC and
          Data Organization in C. I'm a Goldwater Scholar and National
          Hispanic Scholar, and I served as president of UNM's Women in
          Computing club.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     Hero / code block (only used on the homepage)
     ============================================ */
  .hero {
    padding-top: var(--line);
    padding-bottom: calc(var(--line) * 1.5);
  }

  /* ============================================
     About: photo + text side by side
     ============================================ */
  .about-body {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .about-photo {
    flex: 0 0 auto;
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  .about-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .about-text h2 {
    margin: 0 0 var(--line);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    line-height: var(--line);
    color: var(--text);
  }

  .about-text p {
    margin: 0 0 var(--line);
    font-size: 16px;
    line-height: var(--line);
    color: var(--text-dim);
    max-width: 64ch;
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .about-body {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about-text p {
      text-align: left;
    }
  }
</style>