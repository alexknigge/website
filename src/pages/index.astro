---
import '../styles/global.css';

const projects = [
  {
    fn: 'buildShardedCache()',
    summary: 'An in-memory key-value store that shards data across nodes with consistent hashing and replication.',
    tags: ['Go', 'gRPC', 'Docker'],
    repo: 'https://github.com/yourname/sharded-cache',
    demo: null,
  },
  {
    fn: 'compileMiniLang()',
    summary: 'A small interpreted language with a hand-written lexer, recursive-descent parser, and tree-walking evaluator.',
    tags: ['TypeScript', 'Compilers', 'CLI'],
    repo: 'https://github.com/yourname/minilang',
    demo: 'https://minilang.example.com',
  },
  {
    fn: 'trackStudyHours()',
    summary: 'A full-stack app for logging study sessions, visualizing trends, and setting weekly goals.',
    tags: ['React', 'Node', 'PostgreSQL'],
    repo: 'https://github.com/yourname/study-tracker',
    demo: 'https://studytracker.example.com',
  },
];

const skills = {
  languages: ['Python', 'TypeScript', 'Go', 'C++', 'SQL'],
  frameworks: ['React', 'Astro', 'Node.js', 'Express'],
  tools: ['Git', 'Docker', 'Linux', 'PostgreSQL'],
  currently_learning: ['Rust', 'Kubernetes'],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alex Knigge — Portfolio</title>
    <meta name="description" content="Alex Knigge — High Performance Computing Jack of All Trades." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="gutter" id="gutter" aria-hidden="true"></div>

    <div class="frame">
      <nav class="tabs" aria-label="Sections">
        <a href="#about" class="tab" data-tab="about" style="--tab-color: var(--accent-green)">
          about<span class="ext">.md</span>
        </a>
        <a href="#projects" class="tab" data-tab="projects" style="--tab-color: var(--accent-cyan)">
          projects<span class="ext">.tsx</span>
        </a>
        <a href="#skills" class="tab" data-tab="skills" style="--tab-color: var(--accent-amber)">
          skills<span class="ext">.json</span>
        </a>
        <a href="#contact" class="tab" data-tab="contact" style="--tab-color: var(--accent-pink)">
          contact<span class="ext">.sh</span>
        </a>
      </nav>

      <main class="content">
        <!-- Hero -->
        <header class="hero" id="top">
          <pre class="code"><code><span class="c-comment">// portfolio.ts</span>
<span class="c-key">import</span> {'{'} Developer {'}'} <span class="c-key">from</span> <span class="c-str">'@me/profile'</span>;

<span class="c-key">const</span> <span class="c-var">alex</span> = <span class="c-key">new</span> <span class="c-fn">Developer</span>({'{'}
  name: <span class="c-str">'Alex Knigge'</span>,
  role: <span class="c-str">'HPC Jack of all Trades'</span>,
  focus: [<span class="c-str">'high performance computing'</span>, <span class="c-str">'system monitoring'</span>, <span class="c-str">'benchmarking'</span>],
  status: <span class="c-str">'Open to PhD Programs and Internships'</span>,
{'}'});

<span class="c-key">export default</span> <span class="c-var">alex</span>;</code></pre>
        </header>

        <!-- About -->
        <section id="about" class="file">
          <div class="file-bar" style="--tab-color: var(--accent-green)">about<span class="ext">.md</span></div>
          <div class="file-body">
            <h2>About</h2>
            <p>
              I am Post-Bach R&D Intern at Sandia National Laboratories working on monitoring the high performance computing clusters across Sandia. I work with LDMS (Lightweight Distributed Metric Service) and enable the users of Sandia's HPCs to see their data in new ways in realtime. I have been working in HPC since 2023, when I competed in Dan Old's Winter Classic Competition. I have since competed in SCC, ISC SCC, and coached several competitions. 
            </p>
            <p>
		Outside of work, I like to travel (I have been to 5 continents!), tinker with my gaming setup and play all kinds of games, and get outside! I ran the Wise Pies 5k and plan to keep running, hiking, climbing, kayaking, and more in my free time. I am also PADI Open Water Scuba certified and love adventures that take me diving!
            </p>
          </div>
        </section>

        <!-- Projects -->
        <section id="projects" class="file">
          <div class="file-bar" style="--tab-color: var(--accent-cyan)">projects<span class="ext">.tsx</span></div>
          <div class="file-body">
            <h2>Projects</h2>
            <div class="project-list">
              {projects.map((p) => (
                <article class="project">
                  <h3 class="project-fn">
                    <span class="c-key">function</span> <span class="c-fn">{p.fn}</span>
                  </h3>
                  <p class="project-summary">{p.summary}</p>
                  <ul class="tags">
                    {p.tags.map((t) => <li class="tag">{t}</li>)}
                  </ul>
                  <div class="project-links">
                    <a href={p.repo} target="_blank" rel="noreferrer">repo</a>
                    {p.demo && (
                      <>
                        <span aria-hidden="true">·</span>
                        <a href={p.demo} target="_blank" rel="noreferrer">demo</a>
                      </>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- Skills -->
        <section id="skills" class="file">
          <div class="file-bar" style="--tab-color: var(--accent-amber)">skills<span class="ext">.json</span></div>
          <div class="file-body">
            <h2>Skills</h2>
            <pre class="code json"><code><span class="c-punct">{'{'}</span>
  <span class="c-str">"languages"</span><span class="c-punct">:</span> [{skills.languages.map((s, i) => (
    <><span class="c-str">"{s}"</span>{i < skills.languages.length - 1 ? <span class="c-punct">, </span> : null}</>
  ))}],
  <span class="c-str">"frameworks"</span><span class="c-punct">:</span> [{skills.frameworks.map((s, i) => (
    <><span class="c-str">"{s}"</span>{i < skills.frameworks.length - 1 ? <span class="c-punct">, </span> : null}</>
  ))}],
  <span class="c-str">"tools"</span><span class="c-punct">:</span> [{skills.tools.map((s, i) => (
    <><span class="c-str">"{s}"</span>{i < skills.tools.length - 1 ? <span class="c-punct">, </span> : null}</>
  ))}],
  <span class="c-str">"currently_learning"</span><span class="c-punct">:</span> [{skills.currently_learning.map((s, i) => (
    <><span class="c-str">"{s}"</span>{i < skills.currently_learning.length - 1 ? <span class="c-punct">, </span> : null}</>
  ))}]
<span class="c-punct">{'}'}</span></code></pre>
          </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="file">
          <div class="file-bar" style="--tab-color: var(--accent-pink)">contact<span class="ext">.sh</span></div>
          <div class="file-body">
            <h2>Contact</h2>
            <pre class="code sh"><code><span class="c-prompt">$</span> echo <span class="c-var">$EMAIL</span>
<a class="c-link" href="mailto:alex@example.com">alex@example.com</a>

<span class="c-prompt">$</span> open <span class="c-var">$GITHUB</span>
<a class="c-link" href="https://github.com/yourname" target="_blank" rel="noreferrer">github.com/yourname</a>

<span class="c-prompt">$</span> open <span class="c-var">$LINKEDIN</span>
<a class="c-link" href="https://linkedin.com/in/yourname" target="_blank" rel="noreferrer">linkedin.com/in/yourname</a>

<span class="c-prompt">$</span> curl -O <span class="c-var">$RESUME</span>
<a class="c-link" href="/resume.pdf">resume.pdf</a></code></pre>
          </div>
        </section>

        <footer class="footer">
          <p>Built with Astro · Deployed on Cloudflare Pages</p>
        </footer>
      </main>
    </div>

    <script>
      // Populate the gutter with line numbers based on document height,
      // keeping the baseline grid (var(--line)) in sync.
      const gutter = document.getElementById('gutter');

      function renderGutter() {
        const line = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--line')
        );
        const total = Math.ceil(document.body.scrollHeight / line) + 4;
        const current = gutter.children.length;

        if (current < total) {
          const frag = document.createDocumentFragment();
          for (let i = current + 1; i <= total; i++) {
            const span = document.createElement('span');
            span.textContent = String(i).padStart(3, '0');
            frag.appendChild(span);
          }
          gutter.appendChild(frag);
        } else if (current > total) {
          for (let i = current; i > total; i--) {
            gutter.removeChild(gutter.lastChild);
          }
        }
      }

      renderGutter();
      window.addEventListener('resize', renderGutter);
      new ResizeObserver(renderGutter).observe(document.body);

      // Highlight the active "tab" based on scroll position.
      const tabs = document.querySelectorAll('.tab');
      const sections = document.querySelectorAll('.file, .hero');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              tabs.forEach((tab) => {
                tab.classList.toggle('active', tab.dataset.tab === id);
              });
            }
          });
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );

      sections.forEach((s) => observer.observe(s));
    </script>

    <style>
      /* ============================================
         Gutter — persistent line numbers
         ============================================ */
      .gutter {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--gutter-w);
        padding-top: calc(var(--line) * 2);
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0;
        background: var(--bg);
        border-right: 1px solid var(--border);
        overflow: hidden;
        user-select: none;
        z-index: 5;
      }

      .gutter span {
        display: block;
        height: var(--line);
        line-height: var(--line);
        padding-right: 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-faint);
        white-space: nowrap;
      }

      @media (max-width: 720px) {
        .gutter {
          display: none;
        }
      }

      /* ============================================
         Frame / layout
         ============================================ */
      .frame {
        margin-left: var(--gutter-w);
        min-height: 100vh;
      }

      @media (max-width: 720px) {
        .frame {
          margin-left: 0;
        }
      }

      .content {
        max-width: var(--content-w);
        margin: 0 auto;
        padding: calc(var(--line) * 2) 24px calc(var(--line) * 4);
      }

      /* ============================================
         Tabs
         ============================================ */
      .tabs {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        gap: 1px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        overflow-x: auto;
      }

      .tab {
        flex: 0 0 auto;
        padding: 12px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-dim);
        text-decoration: none;
        background: var(--bg-tab);
        border-right: 1px solid var(--border);
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
        white-space: nowrap;
      }

      .tab .ext {
        color: var(--tab-color);
      }

      .tab:hover {
        color: var(--text);
      }

      .tab.active {
        color: var(--text);
        border-bottom-color: var(--tab-color);
        background: var(--bg-raised);
      }

      /* ============================================
         Hero / code block
         ============================================ */
      .hero {
        padding-top: var(--line);
        padding-bottom: calc(var(--line) * 1.5);
      }

      .code {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: var(--line);
        color: var(--text);
        white-space: pre;
        overflow-x: auto;
      }

      .c-comment { color: var(--text-dim); }
      .c-key     { color: var(--accent-purple); }
      .c-str     { color: var(--accent-cyan); }
      .c-var     { color: var(--text); }
      .c-fn      { color: var(--accent-amber); }
      .c-punct   { color: var(--text-dim); }
      .c-prompt  { color: var(--accent-pink); }
      .c-link    { color: var(--accent-cyan); text-decoration: underline; text-decoration-color: var(--border); }
      .c-link:hover { text-decoration-color: var(--accent-cyan); }

      /* ============================================
         File sections
         ============================================ */
      .file {
        margin-top: calc(var(--line) * 2);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        background: var(--bg-raised);
      }

      .file-bar {
        padding: 10px 18px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--text-dim);
        background: var(--bg-tab);
        border-bottom: 1px solid var(--border);
      }

      .file-bar .ext {
        color: var(--tab-color);
      }

      .file-body {
        padding: var(--line) 28px calc(var(--line) * 1.5);
      }

      .file-body h2 {
        margin: 0 0 var(--line);
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        line-height: var(--line);
        color: var(--text);
      }

      .file-body p {
        margin: 0 0 var(--line);
        font-size: 16px;
        line-height: var(--line);
        color: var(--text-dim);
        max-width: 64ch;
      }

      .file-body p:last-child {
        margin-bottom: 0;
      }

      /* ============================================
         Projects
         ============================================ */
      .project-list {
        display: flex;
        flex-direction: column;
        gap: var(--line);
      }

      .project {
        padding-top: calc(var(--line) * 0.5);
        border-top: 1px solid var(--border);
      }

      .project:first-child {
        border-top: none;
        padding-top: 0;
      }

      .project-fn {
        margin: 0 0 calc(var(--line) * 0.5);
        font-family: var(--font-mono);
        font-size: 15px;
        font-weight: 500;
        line-height: var(--line);
      }

      .project-summary {
        margin: 0 0 calc(var(--line) * 0.5);
        color: var(--text-dim);
        font-size: 15px;
        line-height: var(--line);
        max-width: 60ch;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        margin-bottom: calc(var(--line) * 0.5);
      }

      .tag {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-dim);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 2px 8px;
      }

      .project-links {
        display: flex;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
      }

      .project-links a {
        color: var(--accent-cyan);
        text-decoration: none;
      }

      .project-links a:hover {
        text-decoration: underline;
      }

      .project-links span {
        color: var(--text-faint);
      }

      /* ============================================
         JSON / shell code blocks inside file-body
         ============================================ */
      .file-body .code {
        margin-top: calc(var(--line) * -0.25);
      }

      .sh .c-link {
        color: var(--accent-cyan);
        text-decoration: none;
      }

      .sh .c-link:hover {
        text-decoration: underline;
      }

      /* ============================================
         Footer
         ============================================ */
      .footer {
        margin-top: calc(var(--line) * 2);
        padding-top: var(--line);
        border-top: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-faint);
        text-align: center;
      }

      .footer p {
        margin: 0;
        line-height: var(--line);
      }
    </style>
  </body>
</html>
